# ==============================================================================
# CampusPilot Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase / PostgreSQL Credentials
# If DATABASE_URL is not set, CampusPilot will fallback to a local SQLite database for offline development.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Authentication
# In development, a fallback student user ID is used when no Authorization header is passed.
DEFAULT_DEV_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=your-jwt-secret-placeholder

# AI Assistant (Optional - for real LLM responses)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Alexa MCP Server Integration
ALEXA_MCP_SERVER_PORT=8001
ALEXA_SKILL_ID=amzn1.ask.skill.your-skill-id-placeholder
ALEXA_CLIENT_SECRET=your-alexa-client-secret-placeholder
